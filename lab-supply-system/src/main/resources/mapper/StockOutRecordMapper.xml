<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.majorlink.lab.mapper.StockOutRecordMapper">

    <resultMap id="BaseResultMap" type="StockOutRecord">
        <id column="id" property="id"/>
        <result column="supply_id" property="supplyId"/>
        <result column="quantity" property="quantity"/>
        <result column="out_type" property="outType"/>
        <result column="application_id" property="applicationId"/>
        <result column="receiver_id" property="receiverId"/>
        <result column="operator_id" property="operatorId"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="supply_name" property="supplyName"/>
        <result column="supply_code" property="supplyCode"/>
        <result column="receiver_name" property="receiverName"/>
        <result column="operator_name" property="operatorName"/>
    </resultMap>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT
            sor.*,
            si.name      AS supply_name,
            si.code      AS supply_code,
            u1.real_name AS receiver_name,
            u2.real_name AS operator_name
        FROM stock_out_record sor
                 LEFT JOIN supply_item si ON sor.supply_id   = si.id
                 LEFT JOIN sys_user u1    ON sor.receiver_id = u1.id
                 LEFT JOIN sys_user u2    ON sor.operator_id = u2.id
        <where>
            <if test="supplyId != null">
                AND sor.supply_id = #{supplyId}
            </if>
        </where>
        ORDER BY sor.create_time DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO stock_out_record (supply_id, quantity, out_type, application_id, receiver_id, operator_id, remark)
        VALUES (#{supplyId}, #{quantity}, #{outType}, #{applicationId}, #{receiverId}, #{operatorId}, #{remark})
    </insert>

</mapper>
